# UI image: Streamlit only. It reaches the API at API_URL (http://api:8000 in compose).
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /ui

COPY requirements.lock.txt ui/requirements.txt ./
RUN pip install -r requirements.txt -c requirements.lock.txt

COPY ui ./
# Theme + "no tracebacks" settings: Streamlit reads .streamlit/ from the working directory.
COPY .streamlit ./.streamlit

RUN useradd --create-home --uid 1000 store && chown -R store /ui
USER store

EXPOSE 8501
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=2)"

CMD ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
