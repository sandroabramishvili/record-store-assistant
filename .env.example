# --- Database ---
# Local development (Postgres from docker compose, published on localhost:5433,
# because a local Windows Postgres already uses 5432).
# Inside Docker, docker-compose.yml overrides this to db:5432.
DATABASE_URL=postgresql+asyncpg://store:store@localhost:5433/record_store

# --- Authentication ---
# Generate a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# --- Gemini ---
# API key from Google AI Studio
GOOGLE_API_KEY=
CHAT_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-001

# --- LangSmith (tracing) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=record-store-assistant

# --- App ---
# dev / test / prod (added to LangSmith tags and metadata)
ENVIRONMENT=dev
